{
  "name": "siddharth-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run -s build:brain",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b",
    "eval": "node --experimental-strip-types --no-warnings scripts/eval.ts",
    "test:e2e": "python3 e2e/e2e.py",
    "build:brain": "rolldown scripts/brain-run.ts -p node -f esm -o dist/brain/evolve.mjs --silent && cp src/lab/weekly.json dist/brain/weekly.json && node dist/brain/evolve.mjs --state dist/brain/state.json --data dist/brain/weekly.json --generations 48",
    "lint": "biome lint src/agent src/jarvis/sales scripts/jarvis-loop.ts",
    "test:agent": "node --experimental-strip-types --no-warnings --test src/agent/agent.test.ts",
    "test": "npm run -s test:agent && node --experimental-strip-types --no-warnings scripts/lab-check.ts && npm run -s eval",
    "jarvis:loop": "node --experimental-strip-types --no-warnings scripts/jarvis-loop.ts"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.85",
    "framer-motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.143.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.143.2",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "zod": "^4.6.5"
  }
}
