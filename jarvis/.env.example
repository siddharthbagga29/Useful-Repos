# Copy to .env and fill in. Never commit .env.
# Comments sit on their own lines because `docker run --env-file` keeps inline text as part of the value.
# A blank value means "use the default".

# ---- Model (both halves) -----------------------------------------------------
# Public service credential. Locally you can use `ant auth login` instead.
ANTHROPIC_API_KEY=
# anthropic | ollama. Defaults: public=anthropic, owner=ollama.
JARVIS_LLM_BACKEND=
JARVIS_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
JARVIS_EFFORT=medium
JARVIS_MAX_TOKENS=2048
# Owner default 120 (the first answer loads the model); public default 60.
JARVIS_LLM_TIMEOUT_SECONDS=
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
# Blank or "auto" = the Qwen 3 size that fits this Mac's memory (8 GB: qwen3:4b-instruct, 16 GB: qwen3:8b,
# 24-32 GB: qwen3:14b, 48 GB+: qwen3:30b). Must support tool calling.
# Owner precedence: --model flag > JARVIS_* shell variables > jarvis/.env > auto.
# In jarvis/.env the JARVIS_ prefix is optional (OLLAMA_MODEL=qwen3:4b works there).
JARVIS_OLLAMA_MODEL=
# Context window. Ollama's own default can truncate Jarvis's tool list.
JARVIS_OLLAMA_NUM_CTX=8192
# Keep the model loaded between requests so replies stay fast.
JARVIS_OLLAMA_KEEP_ALIVE=30m
# Defaults to knowledge/brief.md.
JARVIS_BRIEF_PATH=

# ---- Public service ----------------------------------------------------------
# The Docker image sets 0.0.0.0.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8080
# Comma-separated origins allowed to call the API from a browser.
JARVIS_ALLOWED_ORIGINS=https://your-portfolio.example
# true only behind exactly one trusted proxy.
JARVIS_TRUST_PROXY_HEADERS=false
JARVIS_RATE_PER_MINUTE=10
JARVIS_RATE_BURST=5
JARVIS_MAX_QUESTION_CHARS=600
JARVIS_MAX_HISTORY_TURNS=6
JARVIS_CONTACTS_DB=var/contacts.sqlite3
# Random string. Leave empty to store no IP-derived data at all.
JARVIS_IP_HASH_SALT=

# ---- Owner agent (Mac) -------------------------------------------------------
JARVIS_STATE_DIR=~/.jarvis
JARVIS_MAX_AGENT_STEPS=8
JARVIS_DEFAULT_CALENDAR=Calendar
# auto = best installed British voice (Jamie Premium first), or any name from `say -v '?'`.
JARVIS_VOICE=auto
# In voice mode, a spoken "yes" approves level 2 steps. false = a Cancel/Allow dialog instead.
JARVIS_VOICE_CONFIRM=true
# standard: level 0-1 steps run on their own. strict: every action waits for a yes.
JARVIS_AUTONOMY=standard
# One "Hey Jarvis" opens a conversation; it stays open (no wake word needed) until this many
# seconds of silence, or until you say "go to sleep" / "that's all".
JARVIS_SESSION_IDLE_SECONDS=30
# Longest single request (dictating a whole idea is fine), and the pause that ends it. Raise the
# pause (e.g. 2.5) if he cuts you off while you think mid-sentence.
JARVIS_MAX_UTTERANCE_SECONDS=90
JARVIS_END_OF_SPEECH_SECONDS=1.5
# "Hey Jarvis" while he's talking stops him and listens.
JARVIS_BARGE_IN=true
# Hours with no speech or banners, e.g. 22-7. Notifications still queue in the app.
JARVIS_QUIET_HOURS=
# LinkedIn. off (default) = assisted: Jarvis opens the contact-info editor and copies the link,
# you press Save. on = Jarvis does it in his own browser window and verifies it after a reload.
# LinkedIn's User Agreement prohibits automated tools, so "on" is at your account's risk.
JARVIS_LINKEDIN_AUTOMATION=off
JARVIS_LINKEDIN_PROFILE=https://www.linkedin.com/in/siddharth-bagga-sid29/
JARVIS_PORTFOLIO_URL=https://siddharthbagga29.github.io/
# Only if Playwright's own Chromium can't be used.
JARVIS_CHROMIUM_PATH=
# The repo Jarvis reads for status (agent/tasks.json, git log). Defaults to this checkout.
JARVIS_REPO_DIR=
# Site knowledge index. Defaults to portfolio/public/jarvis/site-index.json.
JARVIS_SITE_INDEX=

# ---- Website link (localhost gateway) ----------------------------------------
# Binds 127.0.0.1 only. The pairing token lives in $JARVIS_STATE_DIR/bridge_token (mode 0600).
JARVIS_BRIDGE_PORT=8765
# Comma-separated origins allowed to talk to the gateway (http://localhost:* is always allowed).
JARVIS_BRIDGE_ORIGINS=https://siddharthbagga29.github.io
JARVIS_WHISPER_MODEL=base.en
# Wake word engine: openwakeword (free, no key) or porcupine (needs a free Picovoice key).
JARVIS_WAKE_ENGINE=openwakeword
# openWakeWord score (0-1) that counts as "Hey Jarvis". Raise it if it triggers on its own.
JARVIS_WAKE_THRESHOLD=0.5
# Only for JARVIS_WAKE_ENGINE=porcupine. Free key at console.picovoice.ai.
JARVIS_PICOVOICE_ACCESS_KEY=

# --- Positioning OS + benchmark ---
# Apps Script web-app URL (…/exec). Contacts left through /api/contact are forwarded to the sheet.
JARVIS_SHEETS_WEBHOOK=
# jarvis-bench database. When set, jarvis-public serves the benchmark-promoted prompt refinement.
JARVIS_PROMPT_DB=
